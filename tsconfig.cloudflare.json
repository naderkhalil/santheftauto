{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022"], "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "noEmit": true, "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true, "types": ["@cloudflare/workers-types"]
  },
  "include": ["cloudflare/**/*.ts"],
  "exclude": ["cloudflare/**/*.test.ts"]
}
