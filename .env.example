# Analytics is off without an explicit public PostHog project key.
# For a production Cloudflare deployment, copy this to .env.cloudflare.local
# and set your own key. Ordinary builds do not load that file.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# With a key, tracking defaults to production builds only.
# Uncomment to disable tracking even when a key is configured.
# VITE_POSTHOG_ENABLED=false
